+            tool_prompts.append(
+                """You have access to a 'showCodeBlock' tool for displaying code with syntax highlighting.
+When you want to show code to the user, you MUST use this tool instead of markdown code blocks.
+
+To use it, call the showCodeBlock tool with:
+- code: The code to display (required)
+- language: The programming language for syntax highlighting, e.g., 'python', 'javascript', 'typescript', 'bash' (required)
+- filename: Optional filename to display in the header
+- showLineNumbers: Whether to show line numbers (optional, default false)
+- highlightLines: Array of line numbers to highlight (optional)
+
+Example: To show a Python function, call showCodeBlock with code="def hello():\\n    print('Hello')" and language="python"."""
+            )
+    return "\n\n".join(tool_prompts)
+
+
+def _is_frontend_tool(tool_name: str, frontend_tools: list) -> bool:
+    """Check if a tool is a frontend-only tool that should be rendered in the UI."""
+    frontend_tool_names = {tool.name for tool in frontend_tools}
+    return tool_name in frontend_tool_names
+
