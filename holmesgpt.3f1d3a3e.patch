+"""
+Frontend Toolset - Tools that render UI components in the frontend.
+
+These tools don't execute backend logic - they simply return their arguments
+so the frontend can render appropriate UI components.
+"""
+
+from typing import Any, Dict, List, Optional, Tuple
+
+from holmes.core.tools import (
+    Tool,
+    ToolInvokeContext,
+    ToolParameter,
+    Toolset,
+    ToolsetTag,
+    StructuredToolResult,
+    StructuredToolResultStatus,
+)
+
+
+class ShowCodeBlockTool(Tool):
+    """
+    A tool that displays code with syntax highlighting in the frontend.
+
+    This is a frontend-only tool - it returns the code and metadata
+    so the frontend can render it with proper syntax highlighting.
+    """
+
+    def __init__(self, toolset: "FrontendToolset"):
+        super().__init__(
+            name="showCodeBlock",
+            description=(
+                "Display code with syntax highlighting to the user. "
+                "Use this tool whenever you want to show code snippets, scripts, "
+                "configuration files, or any programming code. The code will be "
+                "rendered with proper syntax highlighting in the user interface."
+            ),
+            parameters={
+                "code": ToolParameter(
+                    description="The code to display",
+                    type="string",
+                    required=True,
+                ),
+                "language": ToolParameter(
+                    description=(
+                        "The programming language for syntax highlighting. "
+                        "Examples: python, javascript, typescript, bash, yaml, json, go, rust, java, sql"
+                    ),
+                    type="string",
+                    required=True,
+                ),
+                "filename": ToolParameter(
+                    description="Optional filename to display in the header (e.g., 'example.py')",
+                    type="string",
+                    required=False,
+                ),
+                "showLineNumbers": ToolParameter(
+                    description="Whether to show line numbers (default: false)",
+                    type="boolean",
+                    required=False,
+                ),
+            },
+            toolset=toolset,  # type: ignore
+        )
+
+    def _invoke(self, params: dict, context: ToolInvokeContext) -> StructuredToolResult:
+        """
+        Return the code block parameters for frontend rendering.
+
+        This tool doesn't execute any backend logic - it just passes the
+        parameters through so the frontend can render the code block.
+        """
+        return StructuredToolResult(
+            status=StructuredToolResultStatus.SUCCESS,
+            data={
+                "code": params.get("code", ""),
+                "language": params.get("language", "text"),
+                "filename": params.get("filename"),
+                "showLineNumbers": params.get("showLineNumbers", False),
+            },
+            params=params,
+        )
+
+    def get_parameterized_one_liner(self, params: Dict) -> str:
+        language = params.get("language", "code")
+        filename = params.get("filename")
+        if filename:
+            return f"Show code block: {filename} ({language})"
+        return f"Show {language} code block"
+
+
+class FrontendToolset(Toolset):
+    """
+    Toolset for frontend UI rendering tools.
+
+    These tools enable the LLM to trigger rich UI components in the frontend,
+    such as syntax-highlighted code blocks, charts, and other visualizations.
+    """
+
+    def __init__(self):
+        tools: List[Tool] = []
+        super().__init__(
+            name="frontend",
+            description="Tools for rendering rich UI components like code blocks with syntax highlighting",
+            icon_url="https://platform.robusta.dev/demos/code.svg",
+            prerequisites=[],  # No prerequisites - always available
+            tools=tools,
+            tags=[ToolsetTag.CORE],
+            is_default=True,  # Enable by default
+            docs_url=None,
+        )
+        # Initialize tools after Toolset is created
+        self.tools = [ShowCodeBlockTool(self)]
+
+    def prerequisites_callable(self, config: Dict[str, Any]) -> Tuple[bool, str]:
+        """Frontend tools have no prerequisites."""
+        return True, "Frontend tools are always available"
+
+    def get_example_config(self) -> Dict[str, Any]:
+        """Frontend tools require no configuration."""
+        return {}
